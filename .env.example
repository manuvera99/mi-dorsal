# =============================================================================
# mi-dorsal — Variables de entorno (plantilla)
# =============================================================================
# Copia este archivo a `.env.local` y rellena los valores.
# Cada variable se explica brevemente. Las marcadas con [REQUIRED] son obligatorias.
# =============================================================================

# -------- Convex [REQUIRED] --------
# Obtener desde https://dashboard.convex.dev tras crear un proyecto
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# -------- Clerk [REQUIRED para producción] --------
# Obtener desde https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# El "Issuer" URL del JWT template de Clerk (configurar en Clerk → JWT Templates → Convex)
# En Clerk: JWT Templates → New → Convex → copiar el Issuer (ej: https://your-app.clerk.accounts.dev)
CLERK_JWT_ISSUER_DOMAIN=

# Clerk routes (opcional, defaults razonables)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/calendario
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/calendario

# -------- Resend [REQUIRED para emails] --------
# Obtener desde https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=resultados@mi-dorsal.es

# -------- App --------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------- Modo Mock [OPCIONAL, solo dev] --------
# Si NEXT_PUBLIC_USE_MOCK=true, la app usa datos mock sin necesidad de Clerk/Convex
# Útil para previews y demos sin credenciales
NEXT_PUBLIC_USE_MOCK=true

# -------- Analytics [OPCIONAL] --------
# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Sentry
SENTRY_DSN=
