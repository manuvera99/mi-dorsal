# =============================================================================
# mi-dorsal — Variables de entorno (plantilla)
# =============================================================================
# Copia este archivo a `.env.local` y rellena los valores.
# Cada variable se explica brevemente. Las marcadas con [REQUIRED] son obligatorias.
# =============================================================================

# -------- Convex [REQUIRED] --------
# Obtener desde https://dashboard.convex.dev tras crear un proyecto
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# -------- Clerk [REQUIRED para producción] --------
# Obtener desde https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# El "Issuer" URL del JWT template de Clerk (configurar en Clerk → JWT Templates → Convex)
# En Clerk: JWT Templates → New → Convex → copiar el Issuer (ej: https://your-app.clerk.accounts.dev)
CLERK_JWT_ISSUER_DOMAIN=

# Clerk routes (opcional, defaults razonables)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/calendario
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/calendario

# -------- Resend [REQUIRED para emails] --------
# Obtener desde https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=hola@mi-dorsal.com

# -------- App --------
# URL pública de la app (sin trailing slash)
# IMPORTANTE: cambiar a tu dominio propio cuando lo tengas.
# AdSense rechaza subdominios *.vercel.app, así que mientras estés en vercel.app
# AdSense quedará desactivado aunque configures el client ID.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------- Modo Mock [OPCIONAL, solo dev] --------
# Si NEXT_PUBLIC_USE_MOCK=true, la app usa datos mock sin necesidad de Clerk/Convex
# Útil para previews y demos sin credenciales
NEXT_PUBLIC_USE_MOCK=true

# -------- AI (extraer carrera desde URL) [OPCIONAL] --------
# Por defecto OpenAI gpt-4o-mini. Compatible con cualquier proveedor OpenAI-compatible.
# Para usar MiniMax M3 (gratis, recomendado):
#   OPENAI_BASE_URL=https://api.minimax.io/v1
#   OPENAI_MODEL=MiniMax-M3
#   OPENAI_API_KEY=sk-cp-...
# Para usar OpenAI (dejar OPENAI_BASE_URL vacío):
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# -------- Analytics [OPCIONAL] --------
# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Sentry
SENTRY_DSN=

# -------- Google Analytics 4 [OPCIONAL] --------
# ID de medición GA4 (formato G-XXXXXXXXXX)
# Obtenerlo en https://analytics.google.com → Administrar → Flujos de datos
# Sin esta variable, GA4 NO carga (cero impacto en performance).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# -------- Google Tag Manager [OPCIONAL] --------
# GTM ID (formato GTM-XXXXXXX)
# Si usas GTM, normalmente no necesitas GA_MEASUREMENT_ID aparte
NEXT_PUBLIC_GTM_ID=

# -------- Google Search Console [OPCIONAL] --------
# Código de verificación (solo el `content="..."`, no la meta tag entera)
# Obtenerlo en https://search.google.com/search-console → Verificación → Etiqueta HTML
# Ejemplo: "abc123def456ghi789"
NEXT_PUBLIC_GSC_VERIFICATION=

# -------- Google AdSense [DESACTIVADO hasta tener dominio propio] --------
# ⚠️  AdSense rechaza subdominios *.vercel.app. NO ACTIVAR hasta tener dominio.
# Cuando lo tengas (mi-dorsal.es, por ejemplo):
#   1. Solicita aprobación en https://www.google.com/adsense
#   2. Una vez aprobado, copia tu "ca-pub-XXXXXXXXXXXXXXXX" (16 dígitos)
#   3. Pégalo aquí
#   4. Edita public/ads.txt y descomenta la línea con tu pub-ID
#   5. Redeploy
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# -------- Facebook / Meta verification [OPCIONAL] --------
# Solo si quieres verificar tu web para Meta Business (Facebook Pixel, etc.)
NEXT_PUBLIC_FB_VERIFICATION=
